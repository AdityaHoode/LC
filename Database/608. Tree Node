select 
id,
case
    when p_id is null then 'Root'
    when id in (
        select p_id
        from tree
        group by p_id
        having count(*)>0
    ) then 'Inner'
    else 'Leaf'
end as type
from
tree

-- R1
select
id,
case 
    when p_id is null then 'Root'
    when id in (select distinct p_id from tree) then 'Inner'
    else 'Leaf'
end as type 
from tree

-- depth/level of nodes in a tree
with recursive cte as (
    select
    id,
    1 as level
    from tree
    where p_id is null

    union all

    select 
    a.id,
    level+1 as level
    from tree a
    inner join cte b
    on a.p_id=b.id
)
select * from cte

-- subtree traversal (for node 2)
with recursive cte as (
    select
    id
    from tree
    where id=2

    union all

    select
    id
    from tree a
    inner join cte b
    on a.p_id=b.id 
)
select * from cte

-- ancestor lookup
with recursive cte as (
    select
    p_id
    from tree 
    where id=5

    union all

    select
    a.p_id 
    from tree a
    inner join cte b
    on a.id=b.p_id
    where a.p_id is not null
)
select * from cte

-- depth first ordering
with recursive cte as (
    select
    id,
    cast(id as char(100)) as path
    from tree 
    where p_id is null

    union all

    select
    a.id,
    concat(b.path,'->',a.id)
    from tree a
    inner join cte b
    on a.p_id=b.id
)
select * from cte order by path

-- breadth first ordering
with recursive cte as (
    select
    id,
    1 as level
    from tree
    where p_id is null

    union all

    select
    a.id,
    level+1 as level
    from tree a
    inner join cte b
    on a.p_id=b.id
)
select * from cte order by level