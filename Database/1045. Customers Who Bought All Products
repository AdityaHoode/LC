with c1 as (
    select count(*) as cnt from product
),
c2 as (
    select customer_id, count(distinct product_key) as dcnt
    from customer
    group by customer_id
),
c3 as (
    select * from c2
    where dcnt=(select cnt from c1)
)
select customer_id from c3

-- R1
select
customer_id
from customer
group by 1
having count(distinct product_key)=(select count(*) from product)