select round(sum(tiv_2016),2) as tiv_2016 from 
insurance
where tiv_2015 in (
    select
    tiv_2015
    from
    insurance
    group by tiv_2015
    having count(*)>=2
)
and (lat,lon) in (
    select 
    lat,lon
    from 
    insurance
    group by lat,lon
    having count(*)=1
)


-- R1
with b1 as (
    select
    lat,
    lon
    from insurance
    group by 1,2
    having count(*)=1 
),
b2 as (
    select
    tiv_2015
    from insurance 
    group by 1
    having count(*)>1
)
select 
round(sum(tiv_2016),2) as tiv_2016
from insurance 
where (lat,lon) in (select * from b1)
and tiv_2015 in (select * from b2)