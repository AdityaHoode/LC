select 
a.book_id
,title
,author
,genre
,publication_year
,count(*) as current_borrowers 
from  
borrowing_records a
left join
library_books b
on a.book_id=b.book_id
where a.return_date is null
group by a.book_id
having current_borrowers=max(b.total_copies)
order by current_borrowers desc, title asc

