select
user_id,
count(*) as prompt_count,
round(avg(tokens),2) as avg_tokens
from
prompts
group by user_id
having prompt_count>=3
and max(tokens) > avg_tokens
order by avg_tokens desc, user_id asc

-- R1
select
user_id,
count(*) as prompt_count,
round(avg(tokens),2) as avg_tokens
from (
    select
    user_id,
    tokens,
    tokens>avg(tokens) over (partition by user_id) as hp
    from prompts
) a
group by 1
having count(*)>=3
and sum(hp)>=1
order by 3 desc, 1