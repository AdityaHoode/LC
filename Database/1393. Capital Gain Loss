with cte as (
    select *,
           row_number() over (partition by stock_name, operation order by operation_day) as rn
    from stocks
)
select
    b.stock_name,
    sum(s.price - b.price) as capital_gain_loss 
from
    cte b
join
    cte s
on b.stock_name = s.stock_name
and b.rn = s.rn
where
    b.operation = 'Buy'
    and s.operation = 'Sell'
group by
    b.stock_name;

-- R1
select 
stock_name,
sum(case when operation='Sell' then price else 0 end) - sum(case when operation='Buy' then price else 0 end) as capital_gain_loss 
from stocks
group by stock_name
