with cte as
(
    select count(*) as ttl from users
)
select
contest_id,
round(count(user_id)/ttl*100, 2) as percentage
from
register
cross join
cte
group by contest_id
order by percentage desc, contest_id asc

-- R1
select
contest_id,
round((count(*)/(select count(*) from users))*100,2) as percentage
from register
group by contest_id
order by 2 desc, 1